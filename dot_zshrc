# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# Plugins
plugins=(git tmux fzf fzf-tab zsh-autosuggestions)

# fzf settings
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

# tmux settings
ZSH_TMUX_CONFIG="$HOME/.config/tmux/.tmux.conf"
ZSH_TMUX_AUTOSTART=true
ZSH_TMUX_AUTOQUIT=true

source $ZSH/oh-my-zsh.sh

# Aliases
alias ff="fastfetch"
alias update="brew update && brew upgrade && brew cleanup --prune=all && brew doctor"
alias spotify="spotify_player"

# Homebrew Python to PATH
export PATH="/usr/local/opt/python/libexec/bin:$PATH"

# Homebrew PATH
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"

# Path to emacs installation
eval "$(/opt/homebrew/bin/brew shellenv)"

# Emacs to PATH
export PATH="$HOME/.config/emacs/bin:$PATH"

# because my gpg keeps on failing for some reason
export GPG_TTY=$(tty)
