# Fonts
font-family = JetBrainsMono
font-size = 11

# Padding
window-padding-x = 16
window-padding-y = 16

# Window size
window-height = 500
window-width = 500

# Background
background-opacity = 0.85
background-blur = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Misc
macos-titlebar-style = hidden
shell-integration-features = false
quit-after-last-window-closed = true
mouse-hide-while-typing = true

# Keybinds

keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right

keybind = ctrl+a>arrow_left=goto_split:left
keybind = ctrl+a>arrow_down=goto_split:down
keybind = ctrl+a>arrow_up=goto_split:up
keybind = ctrl+a>arrow_right=goto_split:right